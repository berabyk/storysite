# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# build output
/dist
*.tsbuildinfo

# generated Notion images (regenerated at build time from Notion)
/public/content/images/

# local env files
.env
.env.local
.env*.local

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea
