# Notion integration — used ONLY at build time by scripts/fetch-notion.mjs.
# These are never shipped to the browser. Copy this file to `.env` and fill in.

# Notion internal integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Story databases
NOTION_TR_DATABASE_ID=
NOTION_EN_DATABASE_ID=

# Character databases
NOTION_CHARACTER_TR_DATABASE_ID=
NOTION_CHARACTER_EN_DATABASE_ID=

# Optional: override where the app reads content from at runtime.
# Default is "/content" (static files). Point this at a real API later.
# VITE_CONTENT_BASE=/content
